# TMNP Helicopter Tracking System - Environment Variables
# Copy this file to .env and fill in your actual values

# Admin Authentication (REQUIRED)
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=your-secure-password-here

# Session Security (REQUIRED)
# Generate a random string for session encryption
SESSION_SECRET=your-random-session-secret-here

# Server Configuration
PORT=4000

# Google Cloud Storage (Optional - for cloud storage features)
GCS_BUCKET_NAME=your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Instructions:
# 1. Copy this file: cp env.example .env
# 2. Edit .env with your actual values
# 3. Never commit .env to version control
# 4. Generate a secure SESSION_SECRET (32+ characters)
# 5. Use strong passwords for ADMIN_PASSWORD
