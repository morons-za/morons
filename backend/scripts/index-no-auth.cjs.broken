        </style>
    </head>
    <body>
        <h1>🚁 Helicopter KML Upload</h1>
        
        <div class="info">
            <h3>🔓 No Authentication Mode</h3>
            <p>This server is running without authentication - suitable for local development only.</p>
            <p><strong>Current Status:</strong> FLIGHT_COUNT flights loaded, HELICOPTER_COUNT helicopters in database</p>
        </div>

        <div class="upload-form">
            <h3>Upload KML Files</h3>
            
            <!-- Drag and Drop Area -->
            <div id="dropZone" class="drop-zone">
                <div class="drop-zone-content">
                    <div class="drop-icon">📁</div>
                    <p class="drop-text">Drag and drop KML files here</p>
                    <p class="drop-subtext">or click to browse</p>
                    <button type="button" id="browseBtn" class="browse-btn">Browse Files</button>
                </div>
            </div>
            
            <!-- Hidden File Input -->
            <form id="uploadForm" enctype="multipart/form-data" style="display: none;">
                <input type="file" id="fileInput" name="kml" accept=".kml" multiple>
                <label>
                    <input type="checkbox" name="overwrite"> Overwrite existing files
                </label>
            </form>
            
            <!-- Selected Files List -->
            <div id="selectedFiles" class="selected-files" style="display: none;">
                <h4>Selected Files:</h4>
                <div id="filesList"></div>
                <div class="upload-controls">
                    <button id="uploadBtn" class="upload-btn">Upload All Files</button>
                    <button id="clearBtn" class="clear-btn">Clear All</button>
                </div>
            </div>
            
            <!-- Upload Progress -->
            <div id="uploadProgress" class="upload-progress" style="display: none;">
                <h4>Upload Progress:</h4>
                <div class="progress-bar">
                    <div id="progressFill" class="progress-fill"></div>
                    <span id="progressText" class="progress-text">0%</span>
                </div>
                <div id="uploadStatus" class="upload-status"></div>
            </div>
            
            <!-- Upload Results -->
            <div id="uploadResults" class="upload-results" style="display: none;">
                <h4>Upload Results:</h4>
                <div id="resultsList"></div>
            </div>
        </div>

        <!-- Validation Section -->
        <div class="upload-form">
            <h3>🔍 File Validation</h3>
            <p>Check the status of KML files, optimized versions, and PNG flight maps.</p>
            <button onclick="validateFiles()" style="background: #17a2b8;">Validate Files</button>
            
            <div id="validationResults" class="validation-results" style="display: none; margin-top: 15px;">
                <h4>Validation Results:</h4>
                <div id="validationContent"></div>
            </div>
        </div>
        
        <div>
            <h3>Actions</h3>
            <button onclick="refreshMetadata()">Refresh Metadata</button>
            <button onclick="processKMLs()">Process KMLs</button>
            <button onclick="optimizeKMLs()">Optimize KMLs</button>
            <button onclick="viewUploads()">View Uploads</button>
            <button onclick="viewMetadata()">View Metadata</button>
        </div>
        
        <div id="processingStatus"></div>

        <script>
            let selectedFiles = [];
            
            // DOM elements
            const dropZone = document.getElementById('dropZone');
            const fileInput = document.getElementById('fileInput');
            const browseBtn = document.getElementById('browseBtn');
            const selectedFilesDiv = document.getElementById('selectedFiles');
            const filesList = document.getElementById('filesList');
            const uploadBtn = document.getElementById('uploadBtn');
            const clearBtn = document.getElementById('clearBtn');
            const uploadProgress = document.getElementById('uploadProgress');
            const progressFill = document.getElementById('progressFill');
            const progressText = document.getElementById('progressText');
            const uploadStatus = document.getElementById('uploadStatus');
            const uploadResults = document.getElementById('uploadResults');
            const resultsList = document.getElementById('resultsList');
            
            // File size formatting
            function formatFileSize(bytes) {
                if (bytes < 1024) return bytes + ' B';
                if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
                return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
            }
            
            // Add files to selection
            function addFiles(files) {
                const newFiles = Array.from(files).filter(file => {
                    if (!file.name.toLowerCase().endsWith('.kml')) {
                        alert('Skipping ' + file.name + ': Only KML files are allowed');
                        return false;
                    }
                    // Check if file already selected
                    const exists = selectedFiles.some(f => f.name === file.name && f.size === file.size);
                    if (exists) {
                        console.log('File ' + file.name + ' already selected');
                        return false;
                    }
                    return true;
                });
                
                selectedFiles = selectedFiles.concat(newFiles);
                updateFilesList();
            }
            
            // Update files list display
            function updateFilesList() {
                if (selectedFiles.length === 0) {
                    selectedFilesDiv.style.display = 'none';
                    return;
                }
                
                selectedFilesDiv.style.display = 'block';
                filesList.innerHTML = selectedFiles.map((file, index) =>
                    '<div class="file-item">' +
                        '<span class="file-name">' + file.name + '</span>' +
                        '<span class="file-size">' + formatFileSize(file.size) + '</span>' +
                        '<button class="remove-file" onclick="removeFile(' + index + ')">Remove</button>' +
                    '</div>'
                ).join('');
            }
            
            // Remove file from selection
            function removeFile(index) {
                selectedFiles.splice(index, 1);
                updateFilesList();
            }
            
            // Clear all selected files
            function clearAllFiles() {
                selectedFiles = [];
                updateFilesList();
                hideResults();
            }
            
            // Hide upload results
            function hideResults() {
                uploadProgress.style.display = 'none';
                uploadResults.style.display = 'none';
            }
            
            // Update progress
            function updateProgress(percent, status) {
                progressFill.style.width = percent + '%';
                progressText.textContent = percent + '%';
                uploadStatus.textContent = status;
            }
            
            // Upload files
            async function uploadFiles() {
                if (selectedFiles.length === 0) {
                    alert('No files selected');
                    return;
                }
                
                // Show progress
                uploadProgress.style.display = 'block';
                uploadResults.style.display = 'none';
                updateProgress(0, 'Preparing upload...');
                
                try {
                    // Create FormData with all files
                    const formData = new FormData();
                    selectedFiles.forEach(file => {
                        formData.append('kml', file);
                    });
                    
                    // Add overwrite checkbox value
                    const overwrite = document.querySelector('input[name="overwrite"]').checked;
                    formData.append('overwrite', overwrite);
                    
                    updateProgress(10, 'Uploading ' + selectedFiles.length + ' files...');
                    
                    // Upload with progress
                    const response = await fetch('/upload', {
                        method: 'POST',
                        body: formData
                    });
                    
                    updateProgress(80, 'Processing files...');
                    
                    const result = await response.json();
                    
                    updateProgress(100, 'Upload completed!');
                    
                    // Show results
                    setTimeout(() => {
                        displayResults(result);
                    }, 500);
                    
                } catch (error) {
                    console.error('Upload error:', error);
                    uploadStatus.textContent = 'Upload failed: ' + error.message;
                    uploadStatus.className = 'upload-status error';
                }
            }
            
            // Display upload results
            function displayResults(result) {
                uploadResults.style.display = 'block';
                
                let html = '';
                
                if (result.success) {
                    html += '<div class="result-item success">' +
                        '<span>✅ Successfully uploaded ' + result.processed + ' of ' + result.totalFiles + ' files</span>' +
                    '</div>';
                    
                    // Show successful uploads
                    if (result.results && result.results.length > 0) {
                        result.results.forEach(file => {
                            html += '<div class="result-item success">' +
                                '<div>' +
                                    '<span class="result-filename">' + file.filename + '</span>' +
                                    '<div class="result-details">' +
                                        (file.registration ? 'Registration: ' + file.registration : '') +
                                        (file.date ? ' | Date: ' + file.date : '') +
                                        (file.time ? ' | Time: ' + file.time : '') +
                                    '</div>' +
                                '</div>' +
                            '</div>';
                        });
                    }
                    
                    // Show errors if any
                    if (result.errors && result.errors.length > 0) {
                        result.errors.forEach(error => {
                            html += '<div class="result-item error">' +
                                '<div>' +
                                    '<span class="result-filename">' + error.filename + '</span>' +
                                    '<div class="result-details">Error: ' + error.error + '</div>' +
                                '</div>' +
                            '</div>';
                        });
                    }
                    
                    // Clear selected files after successful upload
                    if (result.processed > 0) {
                        setTimeout(() => {
                            clearAllFiles();
                        }, 2000);
                    }
                } else {
                    html = '<div class="result-item error">' +
                        '<span>❌ Upload failed: ' + result.error + '</span>' +
                    '</div>';
                }
                
                resultsList.innerHTML = html;
            }
            
            // Event listeners
            dropZone.addEventListener('click', () => fileInput.click());
            browseBtn.addEventListener('click', () => fileInput.click());
            
            fileInput.addEventListener('change', (e) => {
                if (e.target.files.length > 0) {
                    addFiles(e.target.files);
                }
            });
            
            uploadBtn.addEventListener('click', uploadFiles);
            clearBtn.addEventListener('click', clearAllFiles);
            
            // Drag and drop events
            dropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropZone.classList.add('drag-over');
            });
            
            dropZone.addEventListener('dragleave', (e) => {
                e.preventDefault();
                if (!dropZone.contains(e.relatedTarget)) {
                    dropZone.classList.remove('drag-over');
                }
            });
            
            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('drag-over');
                
                const files = e.dataTransfer.files;
                if (files.length > 0) {
                    addFiles(files);
                }
            });
            
            // Prevent default drag behaviors on document
            document.addEventListener('dragover', (e) => e.preventDefault());
            document.addEventListener('drop', (e) => e.preventDefault());
            
            async function refreshMetadata() {
                try {
                    const response = await fetch('/refresh-metadata', { method: 'POST' });
                    const result = await response.json();
                    alert('✅ Metadata refresh started');
                } catch (error) {
                    alert('❌ Error: ' + error.message);
                }
            }
            
            function viewUploads() {
                window.open('/uploads', '_blank');
            }
            
            function viewMetadata() {
                window.open('/metadata', '_blank');
            }
            
            async function processKMLs() {
                const statusDiv = document.getElementById('processingStatus');
                try {
                    statusDiv.innerHTML = '<div class="status">🧠 Running Smart KML Manager...</div>';
                    const response = await fetch('/process-kmls', { method: 'POST' });
                    const result = await response.json();
                    
                    if (response.ok) {
                        const { processed, renamed, duplicates } = result.results;
                        statusDiv.innerHTML = '<div class="status success">✅ Processing complete: ' + processed + ' processed, ' + renamed + ' renamed, ' + duplicates + ' duplicates found</div>';
                    } else {
                        statusDiv.innerHTML = '<div class="status error">❌ Error: ' + result.error + '</div>';
                    }
                } catch (error) {
                    statusDiv.innerHTML = '<div class="status error">❌ Network error: ' + error.message + '</div>';
                }
            }
            
            async function optimizeKMLs() {
                const statusDiv = document.getElementById('processingStatus');
                try {
                    statusDiv.innerHTML = '<div class="status">🔧 Creating optimized KML files...</div>';
                    const response = await fetch('/optimize-kmls', { method: 'POST' });
                    const result = await response.json();
                    
                    if (response.ok) {
                        statusDiv.innerHTML = '<div class="status success">✅ KML optimization completed successfully</div>';
                    } else {
                        statusDiv.innerHTML = '<div class="status error">❌ Error: ' + result.error + '</div>';
                    }
                } catch (error) {
                    statusDiv.innerHTML = '<div class="status error">❌ Network error: ' + error.message + '</div>';
                }
            }
            
            async function validateFiles() {
                const validationResults = document.getElementById('validationResults');
                const validationContent = document.getElementById('validationContent');
                
                try {
                    validationResults.style.display = 'block';
                    validationContent.innerHTML = '<div class="status">🔍 Validating files...</div>';
                    
                    const response = await fetch('/validate-files');
                    const result = await response.json();
                    
                    if (response.ok && result.success) {
                        const { counts, missing } = result;
                        
                        let html = '<div class="validation-summary">';
                        html += '<div class="validation-card">';
                        html += '<h5>📁 KML Files</h5>';
                        html += '<div class="validation-number">' + counts.uploads + '</div>';
                        html += '<div>in uploads folder</div>';
                        html += '</div>';
                        
                        html += '<div class="validation-card">';
                        html += '<h5>⚡ Optimized Files</h5>';
                        html += '<div class="validation-number">' + counts.optimized + '</div>';
                        html += '<div>optimized versions</div>';
                        html += '</div>';
                        
                        html += '<div class="validation-card">';
                        html += '<h5>🖼️ PNG Images</h5>';
                        html += '<div class="validation-number">' + counts.pngImages + '</div>';
                        html += '<div>flight map images</div>';
                        html += '</div>';
                        html += '</div>';
                        
                        // Show missing files sections
                        html += '<div class="validation-missing">';
                        
                        if (missing.optimized.length > 0) {
                            html += '<div class="missing-section">';
                            html += '<h5>⚠️ Missing Optimized Files (' + missing.optimized.length + ')</h5>';
                            html += '<div class="missing-files">';
                            missing.optimized.forEach(file => {
                                html += '<div>• ' + file + '</div>';
                            });
