// Load TMNP boundary from external KML file
function loadTmnpBoundary() {
    if (typeof omnivore === 'undefined') {
        console.error('❌ Omnivore not available, cannot load TMNP boundary');
        return;
    }
    
    const tmnpCacheBust = window.buildTimestamp ? '?v=' + encodeURIComponent(window.buildTimestamp) : '';
    console.log('📄 Loading TMNP boundary from ./tmnp.kml...');
    
    try {
        window.tmnpLayer = omnivore.kml('./tmnp.kml' + tmnpCacheBust, null, L.geoJson(null, {
            style: function(feature) {
                return {
                    color: '#ff0000',
                    weight: 3,
                    opacity: 0.7,
                    fillColor: '#ff0000',
                    fillOpacity: 0.25
                };
            }
        })).addTo(map);
        
        window.tmnpLayer.on('ready', function() {
            console.log('✅ TMNP boundary loaded successfully from external file');
            // Fit map to show TMNP boundary if no flights are loaded yet
            if (filteredData.length === 0) {
                map.fitBounds(window.tmnpLayer.getBounds(), { padding: [20, 20] });
            }
        });
        
        window.tmnpLayer.on('error', function(e) {
            console.error('❌ Error loading TMNP boundary:', e);
        });
    } catch (error) {
        console.error('❌ Failed to load TMNP boundary:', error);
    }
}

